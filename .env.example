NODE_ENV=production
PORT=3000
# Set a long random token (at least 24 characters) to manage the comparison corpus.
ADMIN_TOKEN=replace-with-a-long-random-secret
# Optional Arabic AI detector endpoint; without it, AI detection returns an honest unavailable message.
AI_DETECTOR_URL=
AI_DETECTOR_API_KEY=
OPENALEX_MAILTO=
# On Render paid service with persistent disk, set DATA_DIR=/var/data
DATA_DIR=./data
